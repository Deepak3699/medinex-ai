# Use the pooled connection string from Neon for the app runtime.
# Keep this file private as .env; never put the connection string in frontend code.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate a unique long random value for local deployments.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Gemini is called by the backend only. Leave unset until an API key is available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
HOSPITAL_TIMEZONE=Asia/Kolkata

APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
